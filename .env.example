NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional for server-side admin jobs only. NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-side AI agent bridge for /app/atendimento.
# Keep the token only in the server/cPanel environment; never expose it with NEXT_PUBLIC_.
AI_AGENT_WEBHOOK_URL=
AI_AGENT_WEBHOOK_TOKEN=


# Meta Graph / WhatsApp Cloud API. Keep all secrets server-side only.
META_GRAPH_API_VERSION=v23.0
META_GRAPH_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=


# n8n server-side integration. Never expose these with NEXT_PUBLIC_.
N8N_BASE_URL=
N8N_API_KEY=
# Shared secret used by n8n when calling /api/ai-agent/reply and optionally by CRM -> n8n webhook.
N8N_WEBHOOK_TOKEN=
